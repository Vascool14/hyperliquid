{
    "name": "hydromancer-charts",
    "version": "0.1.0",
    "type": "module",
    "description": "Embeddable Hyperliquid candles with liquidation-exposure and TP/SL profiles, built on TradingView Lightweight Charts.",
    "license": "MIT",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/types/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "vite build && tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json"
    },
    "dependencies": {
        "@msgpack/msgpack": "3.1.3",
        "fzstd": "0.1.1",
        "lightweight-charts": "5.2.1"
    }
}
